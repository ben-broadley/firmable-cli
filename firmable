METHODS = ("get", "post", "put", "patch", "delete")


# ---------------------------------------------------------------------------
# errors
# ---------------------------------------------------------------------------

class ApiError(Exception):
    """An HTTP or transport failure against the Firmable API."""

    def __init__(self, status: int | None, message: str, url: str = "", miss: bool = False):
        self.status = status
        self.message = message
        self.url = url
        self.miss = miss
        super().__init__(f"HTTP {status}: {message}" if status else message)


class AuthError(ApiError):
    """The API key was rejected — never worth retrying, and fatal in batch."""


# ---------------------------------------------------------------------------
# spec -> command registry
# ---------------------------------------------------------------------------

def slugify(s: str) -> str:
    return re.sub(r"[^A-Za-z0-9]+", "-", s).strip("-").lower()


def _dest_for(name: str) -> str:
    d = re.sub(r"\W", "_", name)
    if keyword.iskeyword(d) or not d.isidentifier():
        d += "_"
    return d


def _flag_names(name: str) -> list[str]:
    """Offer both the spec spelling and a dashed alias (--ln_slug / --ln-slug)."""
    flags = [f"--{name}"]
    dashed = "--" + re.sub(r"(?<!^)(?=[A-Z])", "-", name).replace("_", "-").lower()
    if dashed not in flags:
        flags.append(dashed)
    return flags


def load_spec() -> dict:
    if not SPEC_PATH.exists():
        sys.exit(f"openapi.json not found next to this script ({SPEC_PATH})")
    with SPEC_PATH.open() as f:
        return json.load(f)


def _extract_body_schema(op: dict) -> dict | None:
    rb = op.get("requestBody")
    if not rb:
        return None
    schema = ((rb.get("content") or {}).get("application/json") or {}).get("schema")
    if not schema:
        return None
    return {
        "required_top": list(schema.get("required") or []),
        "properties": dict(schema.get("properties") or {}),
    }


def build_registry(spec: dict) -> dict:
    """Map command name -> operation metadata for every operation in the spec.

    Names come from the path (/people/search -> people-search) rather than the
    description, because Firmable's spec carries no summary or operationId.
    """
    registry: dict = {}
    for path, methods in spec.get("paths", {}).items():
        path_level = methods.get("parameters", []) or []
        for method in METHODS:
            op = methods.get(method)
            if not op:
                continue
            op_level = op.get("parameters", []) or []
            seen = {p["name"] for p in op_level}
            params = op_level + [p for p in path_level if p["name"] not in seen]
            name = slugify(path.strip("/")) or "root"
            if name in registry:
                name = f"{method}-{name}"
            base, i = name, 2
            while name in registry:
                name = f"{base}-{i}"
                i += 1
            registry[name] = {
                "path": path,
                "method": method.upper(),
                "description": (op.get("description") or "").strip(),
                "path_params": [p for p in params if p.get("in") == "path"],
                "query_params": [p for p in params if p.get("in") == "query"],
                "body": _extract_body_schema(op),
            }
    return registry


# ---------------------------------------------------------------------------
# rate limiting
# ---------------------------------------------------------------------------

class RateLimiter:
    """Thread-safe spacing of requests to at most `rps` per second."""

    def __init__(self, rps: float):
        self.interval = (1.0 / rps) if rps and rps > 0 else 0.0
        self._lock = threading.Lock()
        self._next_at = 0.0

    def acquire(self) -> None:
        if not self.interval:
            return
        with self._lock:
            now = time.monotonic()
            wait = max(0.0, self._next_at - now)
            self._next_at = max(now, self._next_at) + self.interval
        if wait:
            time.sleep(wait)


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    """Surface 3xx as an HTTPError so we can replay POST bodies ourselves.

    urllib refuses to follow a 307 for a POST and would drop the body if it did,
    and POST /people/search 307-redirects on every call.
    """

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


_OPENER = urllib.request.build_opener(_NoRedirect)


# ---------------------------------------------------------------------------
# http
# ---------------------------------------------------------------------------

def _classify(status: int, body_text: str, url: str) -> ApiError:
    message = body_text.strip()
    try:
        parsed = json.loads(body_text)
        if isinstance(parsed, dict):
            message = str(parsed.get("error") or parsed.get("message") or message)
    except (json.JSONDecodeError, ValueError):
        pass
    if status == 401 or status == 403:
        return AuthError(status, message or "invalid or expired API key", url)
    lowered = message.lower()
    miss = status in (404, 500) and any(m in lowered for m in MISS_MARKERS)
    return ApiError(status, message or f"HTTP {status}", url, miss=miss)


def _same_host(a: str, b: str) -> bool:
    return urllib.parse.urlsplit(a).netloc == urllib.parse.urlsplit(b).netloc


def http_request(
    method: str,
    path: str,
    query: dict | None = None,
    body: object = None,
    api_key: str = "",
    verbose: bool = False,
    dry_run: bool = False,
    limiter: RateLimiter | None = None,
    retries: int = 4,
    timeout: int = 60,
) -> object:
    """Single HTTP entry point. Raises ApiError on failure — never exits."""
    qs_pairs = [(k, v) for k, v in (query or {}).items() if v is not None and v != ""]
    qs = urllib.parse.urlencode(qs_pairs, doseq=True)
    url = BASE_URL + path + (("?" + qs) if qs else "")
    headers = {
        "Accept": "application/json",
        "User-Agent": USER_AGENT,
        "Authorization": f"Bearer {api_key}",
    }
    data = None
    if method in ("POST", "PUT", "PATCH") and body is not None:
        data = json.dumps(body).encode()
        headers["Content-Type"] = "application/json"

    if verbose:
        sys.stderr.write(f"-> {method} {url}\n")
        if data is not None:
            sys.stderr.write(f"   body: {data.decode()}\n")

    if dry_run:
        return {
            "_dry_run": True,
            "method": method,
            "url": url,
            "headers": {k: v for k, v in headers.items() if k != "Authorization"},
            "body": body,
        }

    attempt = 0
    while True:
        attempt += 1
        if limiter:
            limiter.acquire()
        try:
            return _send(method, url, data, headers, timeout, verbose)
        except AuthError:
            raise
        except ApiError as e:
            retryable = (not e.miss) and (e.status == 429 or e.status is None or (e.status or 0) >= 500)
            if not retryable or attempt > retries:
                raise
            delay = min(30.0, 0.5 * (2 ** (attempt - 1)))
            if e.status == 429 and e.retry_after:  # type: ignore[attr-defined]
                delay = max(delay, float(e.retry_after))  # type: ignore[attr-defined]
            if verbose:
                sys.stderr.write(f"   retry {attempt}/{retries} in {delay:.1f}s ({e})\n")
            time.sleep(delay)


def _send(method: str, url: str, data, headers: dict, timeout: int, verbose: bool):
    origin = url
    for _ in range(MAX_REDIRECTS):
        req = urllib.request.Request(url, data=data, method=method, headers=headers)
        try:
            with _OPENER.open(req, timeout=timeout) as resp:
                text = resp.read().decode(errors="replace") or "null"
                try:
                    return json.loads(text)
                except json.JSONDecodeError:
                    return text
        except urllib.error.HTTPError as e:
            if e.code in (301, 302, 303, 307, 308):
                location = e.headers.get("Location")
                if not location:
                    raise _classify(e.code, e.read().decode(errors="replace"), url)
                target = urllib.parse.urljoin(url, location)
                # Never forward the bearer token to another host.
                if not _same_host(origin, target):
                    raise ApiError(e.code, f"refusing cross-host redirect to {target}", url)
                if e.code == 303:
                    method, data = "GET", None
                    headers = {k: v for k, v in headers.items() if k.lower() != "content-type"}
                if verbose:
                    sys.stderr.write(f"   {e.code} -> {target}\n")
                url = target
                continue
            err = _classify(e.code, e.read().decode(errors="replace"), url)
            if e.code == 429:
                err.retry_after = e.headers.get("Retry-After")  # type: ignore[attr-defined]
            raise err
        except (socket.timeout, TimeoutError) as e:
            raise ApiError(None, f"timeout (>{timeout}s): {e}", url)
        except urllib.error.URLError as e:
            raise ApiError(None, f"network error: {e}", url)
    raise ApiError(None, f"too many redirects (>{MAX_REDIRECTS})", origin)


def resolve_api_key(required: bool = True) -> str:
    key = os.environ.get(API_KEY_ENV, "").strip()
    if not key and required:
        sys.exit(
            f"set {API_KEY_ENV} in your environment\n"
            "  create a key at app.firmable.com -> Profile -> Integrations -> API"
        )
    return key


