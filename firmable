# spec-driven single-record commands
# ---------------------------------------------------------------------------

def run_endpoint(registry: dict, name: str, argv: list[str]) -> None:
    meta = registry[name]
    method = meta["method"]
    body_props = (meta.get("body") or {}).get("properties") or {}
    body_required = set((meta.get("body") or {}).get("required_top") or [])

    parser = argparse.ArgumentParser(prog=f"firmable {name}", description=meta["description"])
    dest_map: dict[str, str] = {}
    for p in meta["path_params"]:
        parser.add_argument(p["name"], help=(p.get("description") or "").strip())
    for p in meta["query_params"]:
        dest = _dest_for(p["name"])
        dest_map[dest] = p["name"]
        parser.add_argument(*_flag_names(p["name"]), dest=dest,
                            choices=(p.get("schema") or {}).get("enum"),
                            help=(p.get("description") or "").strip())
    for fname, fschema in body_props.items():
        dest = _dest_for(fname)
        dest_map[dest] = fname
        flags = _flag_names(fname)
        if fname == "selectedCountry":
            flags.append("--country")
        parser.add_argument(*flags, dest=dest, choices=fschema.get("enum"),
                            help=(fschema.get("description") or "").strip())
    if name == "people-search":
        parser.add_argument("--all", action="store_true",
                            help="Page through every match (uses `total` from the response)")
        parser.add_argument("--max", type=int, default=None,
                            help="Stop after this many records when using --all")
        parser.add_argument("--page-size", type=int, default=DEFAULT_PAGE_SIZE,
                            help=f"Records per page when using --all (default {DEFAULT_PAGE_SIZE})")
    if method != "GET":
        parser.add_argument("--body",
                            help="JSON string for the request body (--<field> flags merge over it)")
    parser.add_argument("--out", help="Write JSON to this file instead of stdout")
    parser.add_argument("--csv", help="Also write a flattened CSV to this path")
    parser.add_argument("--raw", action="store_true", help="Print the response envelope untouched")
    parser.add_argument("--verbose", action="store_true", help="Log the request to stderr")
    parser.add_argument("--dry-run", action="store_true", help="Show the request without sending it")
    args = parser.parse_args(argv)

    api_key = resolve_api_key(required=not args.dry_run)
    supplied = {dest_map[d]: v for d, v in vars(args).items() if d in dest_map and v not in (None, "")}

    if method == "GET":
        wanted = IDENTIFIERS.get(name)
        if wanted and not any(k in supplied for k in wanted):
            sys.exit(f"firmable {name}: supply at least one of " + ", ".join(f"--{w}" for w in wanted))
        try:
            result = http_request("GET", meta["path"], query=supplied, api_key=api_key,
                                  verbose=args.verbose, dry_run=args.dry_run)
        except ApiError as e:
            sys.exit(f"firmable {name}: {e}")
        records = None
    else:
        body: dict = json.loads(args.body) if getattr(args, "body", None) else {}
        body.update(supplied)
        missing = [f for f in body_required if f not in body]
        if missing and not args.dry_run:
            sys.exit(f"firmable {name}: missing required " + ", ".join(f"--{m}" for m in missing))
        try:
            if name == "people-search" and not args.dry_run:
                records, total = people_search(
                    api_key, body, fetch_all=args.all, page_size=args.page_size,
                    verbose=args.verbose, max_records=args.max,
                )
                result = {"total": total, "count": len(records), "records": records}
            else:
                result = http_request(method, meta["path"], body=body, api_key=api_key,
                                      verbose=args.verbose, dry_run=args.dry_run)
                records, _ = unwrap_records(result)
        except ApiError as e:
            sys.exit(f"firmable {name}: {e}")

    if args.csv and not args.dry_run:
        flatten, columns = FLATTENERS[CSV_KIND.get(name, "company")]
        source = records if records is not None else [result]
        write_csv(args.csv, [flatten(r) for r in source if isinstance(r, dict)], columns)

    payload = result
    if records is not None and not args.raw and name == "people-search":
        payload = result
    out_text = json.dumps(payload, indent=2, ensure_ascii=False)
    if args.out:
        Path(args.out).write_text(out_text)
        sys.stderr.write(f"wrote {len(out_text):,} bytes to {args.out}\n")
    elif not args.csv:
        print(out_text)


# ---------------------------------------------------------------------------
# batch — CSV in, JSONL + CSV out, rate limited, resumable
# ---------------------------------------------------------------------------

def read_input_rows(path: str, column: str | None, default_column: str) -> tuple[list[dict], list[str], str]:
    """Read a CSV and decide which column holds the lookup value.

    Falls back to the only column when the file has just one, which is what a
    pasted list of domains or LinkedIn URLs usually looks like.
    """
    with open(path, newline="", encoding="utf-8-sig") as f:
        reader = csv.DictReader(f)
        fields = list(reader.fieldnames or [])
        rows = [r for r in reader]
    if not fields:
        sys.exit(f"{path}: no header row found")
    chosen = column or (default_column if default_column in fields else None)
    if chosen is None and len(fields) == 1:
        chosen = fields[0]
    if chosen is None:
        sys.exit(
            f"{path}: no column named '{default_column}'. Pass --column with one of: "
            + ", ".join(fields)
        )
    if chosen not in fields:
        sys.exit(f"{path}: no column named '{chosen}'. Available: " + ", ".join(fields))
    return rows, fields, chosen


def _load_done(out_path: Path) -> set:
    done = set()
    if not out_path.exists():
        return done
    with out_path.open(encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                rec = json.loads(line)
            except json.JSONDecodeError:
                continue
            if rec.get("_input") is not None:
                done.add(rec["_input"])
    return done


def run_batch(values: list[str], worker, out_path: Path, rps: float, concurrency: int,
              resume: bool, label: str) -> None:
    """Fan `values` out over `worker(value, limiter)`, appending JSONL as they land."""
    done = _load_done(out_path) if resume else set()
    todo = [v for v in dict.fromkeys(values) if v and v not in done]
    if done:
        sys.stderr.write(f"{label}: {len(done):,} already in {out_path.name}, {len(todo):,} to go\n")
    if not todo:
        sys.stderr.write(f"{label}: nothing to do\n")
        return

    limiter = RateLimiter(rps)
    lock = threading.Lock()
    counts = {"ok": 0, "miss": 0, "err": 0}
    out_path.parent.mkdir(parents=True, exist_ok=True)
    started = time.monotonic()

    with out_path.open("a", encoding="utf-8") as fh, ThreadPoolExecutor(max_workers=concurrency) as ex:
        futures = {ex.submit(worker, v, limiter): v for v in todo}
        for n, fut in enumerate(as_completed(futures), 1):
            value = futures[fut]
            try:
                rec = {"_input": value, "_ok": True, "data": fut.result()}
                counts["ok"] += 1
            except AuthError as e:
                sys.stderr.write(f"\n{label}: {e} — stopping (fix {API_KEY_ENV} and re-run to resume)\n")
                for f2 in futures:
                    f2.cancel()
                break
            except ApiError as e:
                rec = {"_input": value, "_ok": False, "_miss": e.miss,
                       "_status": e.status, "_error": e.message}
                counts["miss" if e.miss else "err"] += 1
            except Exception as e:  # noqa: BLE001 — one bad row must not kill the run
                rec = {"_input": value, "_ok": False, "_miss": False,
                       "_status": None, "_error": repr(e)}
                counts["err"] += 1
            with lock:
                fh.write(json.dumps(rec, ensure_ascii=False) + "\n")
                fh.flush()
            if n % 25 == 0 or n == len(todo):
                rate = n / max(0.001, time.monotonic() - started)
                sys.stderr.write(
                    f"\r{label}: {n:,}/{len(todo):,}  hit={counts['ok']:,} "
                    f"miss={counts['miss']:,} err={counts['err']:,}  {rate:.1f}/s"
                )
                sys.stderr.flush()
    sys.stderr.write("\n")


def jsonl_to_csv(jsonl_path: Path, csv_path: str, kind: str, order: list[str],
                 extra: dict[str, dict] | None = None) -> None:
    """Rebuild a CSV from the JSONL, in the order the inputs were supplied."""
    flatten, columns = FLATTENERS[kind]
    by_input: dict[str, dict] = {}
    with jsonl_path.open(encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                rec = json.loads(line)
            except json.JSONDecodeError:
                continue
            by_input[rec.get("_input")] = rec

    rows = []
    for value in order:
        rec = by_input.get(value)
        base = {"_input": value, "_status": "", "_error": ""}
        if rec is None:
            base["_status"] = "not run"
        elif rec.get("_ok"):
            base["_status"] = "hit"
            base.update(flatten(rec.get("data") or {}))
        else:
            base["_status"] = "miss" if rec.get("_miss") else "error"
            base["_error"] = rec.get("_error") or ""
        if extra and value in extra:
            base.update(extra[value])
        rows.append(base)

    lead = ["_input", "_status", "_error"]
    if extra:
        lead += [k for k in next(iter(extra.values())).keys() if k not in lead]
    write_csv(csv_path, rows, columns, lead=lead)


def _batch_parser(prog: str, default_column: str, choices: list[str]) -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog=prog)
    p.add_argument("input", help="Input CSV")
    p.add_argument("--by", default=default_column, choices=choices,
                   help=f"Firmable lookup field (default {default_column})")
    p.add_argument("--column", help="CSV column holding the lookup value (default: same as --by)")
    p.add_argument("--out", help="JSONL output path (default: alongside --csv, or <input>.firmable.jsonl)")
    p.add_argument("--csv", help="Flattened CSV output path")
    p.add_argument("--keep-columns", help="Comma-separated input columns to echo into the CSV")
    p.add_argument("--rps", type=float, default=DEFAULT_RPS,
                   help=f"Requests per second (default {DEFAULT_RPS}, API ceiling {RATE_LIMIT_CEILING})")
    p.add_argument("--concurrency", type=int, default=DEFAULT_CONCURRENCY,
                   help=f"Worker threads (default {DEFAULT_CONCURRENCY})")
    p.add_argument("--limit", type=int, help="Only process the first N rows")
    p.add_argument("--force", action="store_true",
                   help="Re-fetch rows already present in the JSONL (spends credits again)")
    p.add_argument("--verbose", action="store_true", help="Log every request to stderr")
    return p


def _resolve_out(args, input_path: str) -> Path:
    if args.out:
        return Path(args.out)
    if args.csv:
        return Path(args.csv).with_suffix(Path(args.csv).suffix + ".jsonl")
    return Path(input_path).with_suffix(".firmable.jsonl")


def _extras(rows, chosen, keep_columns):
    if not keep_columns:
        return None
    keep = [c.strip() for c in keep_columns.split(",") if c.strip()]
    extra = {}
    for r in rows:
        value = (r.get(chosen) or "").strip()
        if value:
            extra[value] = {f"in_{c}": r.get(c, "") for c in keep}
    return extra or None


def cmd_lookup_batch(argv: list[str], endpoint: str) -> None:
    """company-batch / people-batch — one GET per input row."""
    choices = IDENTIFIERS[endpoint]
    default_column = "fqdn" if endpoint == "company" else "ln_url"
    args = _batch_parser(f"firmable {endpoint}-batch", default_column, choices).parse_args(argv)
    if args.rps > RATE_LIMIT_CEILING:
        sys.exit(f"--rps {args.rps} exceeds Firmable's documented {RATE_LIMIT_CEILING}/s ceiling")

    api_key = resolve_api_key()
    rows, _, chosen = read_input_rows(args.input, args.column, args.by)
    values = [(r.get(chosen) or "").strip() for r in rows]
    values = [v for v in values if v]
    if args.limit:
        values = values[: args.limit]
    if not values:
        sys.exit(f"{args.input}: column '{chosen}' is empty")

    path = "/company" if endpoint == "company" else "/people"

    def worker(value: str, limiter: RateLimiter):
        return http_request("GET", path, query={args.by: value}, api_key=api_key,
                            verbose=args.verbose, limiter=limiter)

    out_path = _resolve_out(args, args.input)
    sys.stderr.write(
        f"{endpoint}-batch: {len(values):,} lookups by --by {args.by} from column '{chosen}' "
        f"-> {out_path}\n"
    )
    run_batch(values, worker, out_path, args.rps, args.concurrency,
              resume=not args.force, label=f"{endpoint}-batch")
    if args.csv:
        kind = "company" if endpoint == "company" else "person"
        jsonl_to_csv(out_path, args.csv, kind, list(dict.fromkeys(values)),
                     extra=_extras(rows, chosen, args.keep_columns))


def cmd_roster(argv: list[str]) -> None:
    """roster — people/search fanned out over a CSV of Firmable company ids."""
    p = argparse.ArgumentParser(
        prog="firmable roster",
        description="For each company id, page /people/search. --enrich then buys full "
                    "contact records for every person found (one extra call each).",
    )
    p.add_argument("input", help="Input CSV of Firmable company ids")
    p.add_argument("--column", default="id", help="CSV column holding the company id (default: id)")
    p.add_argument("--position", help="Filter by position")
    p.add_argument("--seniority", help="Filter by seniority")
    p.add_argument("--department", help="Filter by department")
    p.add_argument("--country", default=None, help="selectedCountry (default AU at the API)")
    p.add_argument("--per-company", type=int, default=None, help="Cap people returned per company")
    p.add_argument("--page-size", type=int, default=DEFAULT_PAGE_SIZE)
    p.add_argument("--enrich", action="store_true",
                   help="Also GET /people for each hit — full emails and mobiles, one call per person")
    p.add_argument("--only-contactable", action="store_true",
                   help="With --enrich, only enrich people the search says have an email or mobile")
    p.add_argument("--out", help="JSONL output path")
    p.add_argument("--csv", help="Flattened CSV output path")
    p.add_argument("--rps", type=float, default=DEFAULT_RPS)
    p.add_argument("--concurrency", type=int, default=DEFAULT_CONCURRENCY)
    p.add_argument("--limit", type=int, help="Only process the first N companies")
    p.add_argument("--force", action="store_true", help="Re-fetch companies already in the JSONL")
    p.add_argument("--verbose", action="store_true")
    args = p.parse_args(argv)
    if args.rps > RATE_LIMIT_CEILING:
        sys.exit(f"--rps {args.rps} exceeds Firmable's documented {RATE_LIMIT_CEILING}/s ceiling")

    api_key = resolve_api_key()
    rows, _, chosen = read_input_rows(args.input, args.column, "id")
    values = [v for v in ((r.get(chosen) or "").strip() for r in rows) if v]
    if args.limit:
        values = values[: args.limit]
    if not values:
        sys.exit(f"{args.input}: column '{chosen}' is empty")

    base_body = {k: v for k, v in (
        ("position", args.position),
        ("seniority", args.seniority),
        ("department", args.department),
        ("selectedCountry", args.country),
    ) if v}

    def worker(company_id: str, limiter: RateLimiter):
        body = dict(base_body, companyId=company_id)
        records, total = people_search(api_key, body, fetch_all=True, page_size=args.page_size,
                                       limiter=limiter, verbose=args.verbose,
                                       max_records=args.per_company)
        if args.enrich:
            enriched = []
            for hit in records:
                pid = hit.get("person_id") or hit.get("id")
                if not pid:
                    continue
                if args.only_contactable and not (hit.get("has_email") or hit.get("has_mobile")):
                    enriched.append({**hit, "_enriched": False, "_skipped": "no contact signal"})
                    continue
                try:
                    full = http_request("GET", "/people", query={"id": pid}, api_key=api_key,
                                        verbose=args.verbose, limiter=limiter)
                    enriched.append({**(full or {}), "_enriched": True, "_search": hit})
                except AuthError:
                    raise
                except ApiError as e:
                    enriched.append({**hit, "_enriched": False, "_error": e.message})
            records = enriched
        return {"total": total, "count": len(records), "records": records}

    out_path = _resolve_out(args, args.input)
    sys.stderr.write(f"roster: {len(values):,} companies from column '{chosen}' -> {out_path}\n")
    if args.enrich:
        sys.stderr.write("roster: --enrich buys one extra lookup per person found\n")
    run_batch(values, worker, out_path, args.rps, args.concurrency,
              resume=not args.force, label="roster")

    if args.csv:
        kind = "person" if args.enrich else "search"
        flatten, columns = FLATTENERS[kind]
        out_rows = []
        with out_path.open(encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    rec = json.loads(line)
                except json.JSONDecodeError:
                    continue
                company_id = rec.get("_input")
                if not rec.get("_ok"):
                    out_rows.append({"_company_id": company_id,
                                     "_status": "miss" if rec.get("_miss") else "error",
                                     "_error": rec.get("_error") or ""})
                    continue
                for person in (rec.get("data") or {}).get("records") or []:
                    row = {"_company_id": company_id, "_status": "hit", "_error": person.get("_error", "")}
                    row.update(flatten(person))
                    out_rows.append(row)
        write_csv(args.csv, out_rows, columns, lead=["_company_id", "_status", "_error"])


# ---------------------------------------------------------------------------
# help / dispatch
# ---------------------------------------------------------------------------

BATCH_COMMANDS = {
    "company-batch": "bulk /company lookups from a CSV column",
    "people-batch": "bulk /people lookups from a CSV column",
    "roster": "people/search per company id, optionally enriched to full contact records",
}


def cmd_commands(registry: dict) -> None:
    print("Endpoint commands (from openapi.json):")
    width = max([len(n) for n in registry] + [len(n) for n in BATCH_COMMANDS])
    for name in sorted(registry):
        meta = registry[name]
        print(f"  {name:<{width}}  {meta['method']:5s} {meta['path']}   {meta['description']}")
    print("\nBatch commands (CSV in, JSONL + CSV out, rate limited, resumable):")
    for name, desc in BATCH_COMMANDS.items():
        print(f"  {name:<{width}}  {desc}")
    print("\nAlso: mcp (Firmable MCP tools over the CLI), commands, help <name>")
    print("`firmable help <name>` for flags. Every lookup spends credits.")


def cmd_help(registry: dict, command: str | None) -> None:
    if not command:
        sys.exit("usage: firmable help <command>")
    if command in BATCH_COMMANDS:
        if command == "roster":
            cmd_roster(["--help"])
        else:
            cmd_lookup_batch(["--help"], command.replace("-batch", ""))
        return
    if command not in registry:
        sys.exit(f"unknown command: {command}\n\nRun: firmable commands")
    run_endpoint(registry, command, ["--help"])


def main() -> None:
    argv = sys.argv[1:]
    if argv and argv[0] in ("-V", "--version"):
        print(f"firmable-cli {VERSION}")
        return
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return

    cmd, rest = argv[0], argv[1:]
    registry = build_registry(load_spec())

    if cmd == "commands":
        cmd_commands(registry)
        return
    if cmd == "help":
        cmd_help(registry, rest[0] if rest else None)
        return
    if cmd in ("company-batch", "people-batch"):
        cmd_lookup_batch(rest, cmd.replace("-batch", ""))
        return
    if cmd == "roster":
        cmd_roster(rest)
        return
    if cmd == "mcp":
        # Resolve alongside the real script so a symlinked/shimmed firmable works.
        sys.path.insert(0, str(Path(__file__).resolve().parent))
        from firmable_mcp import main as mcp_main  # noqa: PLC0415 — optional module
        mcp_main(rest)
        return
    if cmd in registry:
        run_endpoint(registry, cmd, rest)
        return

    known = list(registry) + list(BATCH_COMMANDS) + ["mcp", "commands", "help"]
    suggestions = difflib.get_close_matches(cmd, known, n=3, cutoff=0.5)
    msg = f"unknown command: {cmd}"
    if suggestions:
        msg += "\n\nDid you mean:\n" + "\n".join(f"  {s}" for s in suggestions)
    sys.exit(msg + "\n\nRun: firmable commands")


if __name__ == "__main__":
    main()
