# response envelopes
# ---------------------------------------------------------------------------

RECORD_KEYS = ("records", "results", "people", "data")


def unwrap_records(payload) -> tuple[list | None, int | None]:
    """Return (records, total). /people/search wraps them; the spec says it doesn't."""
    if isinstance(payload, list):
        return payload, len(payload)
    if isinstance(payload, dict):
        for k in RECORD_KEYS:
            v = payload.get(k)
            if isinstance(v, list):
                total = payload.get("total")
                return v, int(total) if isinstance(total, (int, float)) else None
    return None, None


# At least one of these must be supplied, or the API has nothing to look up.
IDENTIFIERS = {
    "company": ["id", "ln_slug", "ln_url", "fqdn", "abn", "website"],
    "people": ["id", "ln_slug", "ln_url", "work_email", "personal_email"],
}

CSV_KIND = {"company": "company", "people": "person", "people-search": "search"}


def people_search(
    api_key: str,
    body: dict,
    fetch_all: bool = False,
    page_size: int = DEFAULT_PAGE_SIZE,
    limiter: RateLimiter | None = None,
    verbose: bool = False,
    max_records: int | None = None,
) -> tuple[list, int | None]:
    """POST /people/search, optionally paging on `total` until exhausted."""
    payload = dict(body)
    if not fetch_all:
        result = http_request("POST", "/people/search", body=payload, api_key=api_key,
                              verbose=verbose, limiter=limiter)
        records, total = unwrap_records(result)
        return (records if records is not None else []), total

    collected: list = []
    offset, total = 0, None
    while True:
        payload["from"] = str(offset)
        payload["size"] = str(page_size)
        result = http_request("POST", "/people/search", body=payload, api_key=api_key,
                              verbose=verbose, limiter=limiter)
        records, page_total = unwrap_records(result)
        if page_total is not None:
            total = page_total
        if not records:
            break
        collected.extend(records)
        if max_records and len(collected) >= max_records:
            collected = collected[:max_records]
            break
        if total is not None and len(collected) >= total:
            break
        if len(records) < page_size:
            break
        offset += page_size
    return collected, total


