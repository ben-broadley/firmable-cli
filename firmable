def write_csv(path: str, rows: list[dict], columns: list[str], lead: list[str] | None = None) -> None:
    lead = lead or []
    header = lead + [c for c in columns if c not in lead]
    with open(path, "w", newline="", encoding="utf-8") as f:
        w = csv.DictWriter(f, fieldnames=header, extrasaction="ignore")
        w.writeheader()
        for r in rows:
            w.writerow(r)
    sys.stderr.write(f"wrote {len(rows):,} rows to {path}\n")


