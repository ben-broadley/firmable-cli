def flatten_person(rec: dict) -> dict:
    if not isinstance(rec, dict):
        return {}
    company = rec.get("current_company") or {}
    phones = rec.get("phones") or []
    # is_dnd is real ACMA Do Not Call Register status — Firmable folds the register
    # into their dataset. Split it out here so the distinction survives into a CSV
    # instead of staying buried in a nested field, and a dialler can be pointed at
    # `mobile` alone. It is the register as at Firmable's last refresh, so it is a
    # point-in-time status rather than a live check.
    clean, dnd = [], []
    for p in phones:
        if isinstance(p, dict):
            val = p.get("value")
            if not val:
                continue
            (dnd if p.get("is_dnd") else clean).append(str(val))
        elif p:
            clean.append(str(p))
    slug = rec.get("linkedin") or ""
    edu = rec.get("education") or {}
    if isinstance(edu, dict):
        edu_txt = " / ".join(x for x in [edu.get("school_name"), edu.get("degree"), edu.get("field")] if x)
    else:
        edu_txt = _j(edu)
    secondary = []
    for s in (rec.get("secondary_position") or []):
        if isinstance(s, dict):
            secondary.append(f"{s.get('cleaned_position') or ''} @ {s.get('company_name') or ''}".strip(" @"))
    row = {c: "" for c in PEOPLE_COLUMNS}
    row.update({
        "id": _j(rec.get("id")),
        "name": _j(rec.get("name")),
        "first_name": _j(rec.get("first_name")),
        "last_name": _j(rec.get("last_name")),
        "position": _j(rec.get("position")),
        "seniority": _j(rec.get("seniority")),
        "department": _j(rec.get("department")),
        "headline": _j(rec.get("headline")),
        "linkedin": _j(slug),
        "linkedin_url": f"https://www.linkedin.com/in/{slug}/" if slug else "",
        "location": _j(rec.get("location")),
        "country": _j(rec.get("country")),
        "work_email": _j(_emails(rec.get("emails"), "work")),
        "personal_email": _j(_emails(rec.get("emails"), "personal")),
        "mobile": _j(clean),
        "mobile_dnd": _j(dnd),
        "phones_all": _j([p.get("value") if isinstance(p, dict) else p for p in phones]),
        "company_id": _j(company.get("id")),
        "company_name": _j(company.get("name")),
        "company_website": _j(company.get("website")),
        "company_size": _j(company.get("size")),
        "company_industry": _j(company.get("industry")),
        "company_linkedin": _j(company.get("linkedin")),
        "time_in_current_role": _j(rec.get("time_in_current_role")),
        "year_joined": _j(rec.get("year_joined")),
        "month_joined": _j(rec.get("month_joined")),
        "skills": _j(rec.get("skills")),
        "education": _j(edu_txt),
        "secondary_positions": _j(secondary),
    })
    return row


